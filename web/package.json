{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --output-structure message-modules",
		"prepare": "pnpm run paraglide:compile && (svelte-kit sync || echo '')",
		"check": "pnpm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "pnpm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "oxlint . && oxfmt --check .",
		"format": "oxfmt .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright install chromium && playwright test",
		"screenshots": "playwright install chromium && node scripts/screenshot-pages.mjs"
	},
	"dependencies": {
		"@fontsource/schibsted-grotesk": "^5.3.0"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.5.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^5.0.1",
		"@vitest/coverage-v8": "^5.0.1",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"playwright": "^1.63.0",
		"sass": "^1.104.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
