# copy to .env

POSTGRES_USER=mahjong
POSTGRES_PASSWORD=mahjong
POSTGRES_DB=mahjong
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173
LOG_LEVEL=info

# signs account JWTs and single-use WS connect tickets. guest-first auth: REST
# issues a short-lived ticket for the WS handshake, never a JWT in a query string.
# dev only. real: openssl rand -hex 32
JWT_SECRET=dev-only-not-a-secret

# prod overlay only
# PUBLIC_API_URL=https://api.example.com
# PUBLIC_WS_URL=wss://api.example.com/ws
# CORS_ORIGINS=https://example.com
# TRUSTED_PROXY_IPS=172.16.0.0/12       # the reverse proxy only — never '*'. docs/07-infra.md
