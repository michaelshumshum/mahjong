# copy to .env

POSTGRES_USER=mahjong
POSTGRES_PASSWORD=mahjong
POSTGRES_DB=mahjong
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173
LOG_LEVEL=info

# optional accounts (docs/infra.md §2): /auth/* and /me* 404 unless set
# ACCOUNTS_ENABLED=1
# SESSION_MAX_AGE_DAYS=90
# SESSION_IDLE_DAYS=30

# prod overlay only
# PUBLIC_API_URL=https://mahjong-api.shumshum.dev
# PUBLIC_WS_URL=wss://mahjong-api.shumshum.dev/ws
# CORS_ORIGINS=https://mahjong.shumshum.dev
# PUBLIC_WEB_URL=https://mahjong.shumshum.dev  # post-sign-in redirect; defaults to the first CORS origin
# TRUSTED_PROXY_IPS=172.16.0.0/12       # the reverse proxy only — never '*'. docs/infra.md
# WEB_PORT=3000                         # overrides the 5173 above; must match the tunnel ingress port
